{
  "name": "cockpit-ifr-proxy",
  "version": "1.0.0",
  "description": "Proxy ADS-B PRO+++ avec fallbacks Airplanes.live → OpenSky → AirLabs",
  "type": "module",
  "main": "server.js",

  "scripts": {
    "start": "node server.js",
    "dev": "NODE_ENV=development node server.js",
    "debug": "NODE_ENV=debug node server.js",
    "test-proxy": "curl -s https://localhost:3000/airplanes?lat=50.637&lon=5.443&dist=120",
    "logs": "echo 'Logs Render → https://dashboard.render.com' && tail -f /var/log/render.log",
    "check-env": "node -e \"console.log('AIRLABS_KEY=', process.env.AIRLABS_KEY || '❌ missing')\""
  },

  "dependencies": {
    "express": "^4.18.2",
    "node-fetch": "^3.3.2"
  },

  "engines": {
    "node": ">=18"
  },

  "keywords": [
    "adsb",
    "proxy",
    "opensky",
    "airlabs",
    "airplanes.live",
    "cockpit-ifr",
    "avionics"
  ],

  "author": "Patrick",
  "license": "MIT"
}
